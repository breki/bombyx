# Sample bombyx project configuration.
#
# Copy this to `bombyx.toml` in the ROOT OF THE PROJECT you
# want a VM for -- not here. Each project carries its own
# config next to the `vagrant/` directory it describes.
#
# THERE IS NO `host` KEY HERE, AND ONE IS REFUSED.
# Which machine runs the VMs is a property of whoever is
# driving bombyx, not of the project: everyone has their own
# hardware on their own network. See the bottom of this file.

# Project name. Doubles as the VM's directory name on the
# host, e.g. ~/vms/myproject.
project = "myproject"

# Directory in THIS repo holding the Vagrantfile and
# provisioning scripts. Pushed to the host on every `up`,
# which is what keeps the repo the source of truth.
vagrant_dir = "vagrant"

# Root on the VM host under which project directories are
# created. Scratch VMs land in
# <remote_root>/scratch/<project>/<name>, so the same scratch
# name in two projects cannot collide.
#
# Must be an anchored path (starting with `~` or `/`) at least
# one directory deep, with no `.` or `..` segment. bombyx
# creates, writes into and -- on teardown -- deletes the
# directory it derives from this value, so a root like `/`, `~`
# or `~/.` is refused when the config loads.
#
# A leading `~` is expanded by the remote shell; anywhere else
# it is rejected, as are shell metacharacters.
remote_root = "~/vms"

# WHERE THE VM HOST GOES INSTEAD
#
# bombyx looks in four places, and takes the first that names
# one:
#
#   1. `--host vmhost-b`         a one-off run
#   2. `BOMBYX_HOST=vmhost-b`    a shell, CI, or an agent
#   3. `bombyx.local.toml`       this project only; gitignore it
#   4. your own config.toml      every project -- the usual one
#
# The per-developer file is the one to set up once:
#
#   Linux/macOS  ~/.config/bombyx/config.toml
#   Windows      %APPDATA%\bombyx\config.toml
#
#   # config.toml
#   host = "my-vmhost"
#
# `host` is an SSH alias, resolved through your ~/.ssh/config,
# so bombyx never handles addresses, usernames or keys.
#
# A project that needs a different machine from your usual one
# gets a `bombyx.local.toml` beside this file:
#
#   # bombyx.local.toml
#   host = "other-vmhost"
#
# Every field above can also be overridden there, and every one
# is optional, so name only what differs. The file itself is
# optional; most projects never need one.
