# mise local overrides
.mise.local.toml

# Per-developer config override. `host` is personal, so this
# never belongs in the repo -- and a tracked one would be
# applied on checkout by everyone who clones.
bombyx.local.toml

# Vagrant machine state. Holds the VM's identity: it belongs
# to whichever host booted the VM, never to the repo, and
# bombyx excludes it from the push for the same reason.
.vagrant/
