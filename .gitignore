# Rust
target/
**/target/
**/*.rs.bk
*.pdb

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/settings.local.json

# Environment
.env
.env.*

# Coverage
coverage.xml
coverage.json
*.profraw
*.profdata

# mise local overrides
.mise.local.toml

# Per-project config override. It usually carries a `host`,
# which is personal, so this never belongs in the repo -- and a
# tracked one would be applied on checkout by everyone who
# clones. (A `host` in the committed `bombyx.toml` is refused
# outright; see "Configure" in README.md.)
bombyx.local.toml

# Vagrant machine state. Holds the VM's identity: it belongs
# to whichever host booted the VM, never to the repo, and
# bombyx excludes it from the push for the same reason.
.vagrant/

# Generated attribution, written into the release archives by
# `cargo xtask licenses`. Not committed: it is derived from
# Cargo.lock and would drift the moment a dependency moved.
THIRD-PARTY-LICENSES
