# Rust
target/
**/target/
**/*.rs.bk
*.pdb

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/settings.local.json

# Environment
.env
.env.*

# Coverage
coverage.xml
coverage.json
*.profraw
*.profdata

# mise local overrides
.mise.local.toml

# Vagrant machine state. Holds the VM's identity: it belongs
# to whichever host booted the VM, never to the repo.
.vagrant/

# Generated attribution, written into the release archives by
# `cargo xtask licenses`. Not committed: it is derived from
# Cargo.lock and would drift the moment a dependency moved.
THIRD-PARTY-LICENSES

# A real registry, if one is ever created at the repo root.
# `config.toml.sample` says to copy it outside any repository,
# and this catches the case where somebody does not: the file
# holds the SSH alias of their VM host and a table per project
# they drive. Anchored, so `.cargo/config.toml` is unaffected.
/config.toml

# An old `bombyx.local.toml` left on disk holds the operator's
# VM host name, and `git add -A` would commit it. bombyx never
# opens the file any more, so no command warns about it.
bombyx.local.toml
