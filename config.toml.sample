# Sample bombyx configuration.
#
# Copy this to your own config file, OUTSIDE ANY REPOSITORY:
#
#   Linux/macOS  ~/.config/bombyx/config.toml
#   Windows      %APPDATA%\bombyx\config.toml
#
# This is the only file bombyx reads. It holds every project you
# drive VMs for, one `[projects.<name>]` table each, and it is
# yours: nothing in it is committed anywhere. Name the project
# you mean on the command line -- `bombyx --project myproject
# up` -- because bombyx reads nothing at all from the project's
# own directory and so cannot work it out from where you stand.
#
# Paths in the comments below, such as docs/trust-boundary.md,
# are in bombyx's own repository:
# https://github.com/breki/bombyx
#
# `--config <path>` reads a different file instead, which is
# useful for keeping two setups apart.

# The machine every project runs on, unless its own table says
# otherwise.
#
# Usually an SSH alias, resolved through your ~/.ssh/config, so
# bombyx never handles addresses, usernames or keys.
#
# One case does not go through ssh at all. If this value names
# the machine you are running bombyx on, bombyx runs vagrant
# here and never calls ssh -- see "Running bombyx against your
# own machine" in bombyx's docs/tutorial.md. That comparison
# looks only at the name, not at your ~/.ssh/config, so an
# alias that happens to equal your own machine's name will be
# taken for this machine even when it points elsewhere. Write
# it as `user@name` to force the ssh route.
#
# Which machine runs the VMs is a property of you rather than of
# any project: everyone on a team has their own hardware on
# their own network. That is why this line lives here and not in
# a repository.
host = "my-vmhost"

# One table per project. The table key is the project name, and
# it doubles as the VM's directory name on the host, e.g.
# ~/vms/myproject. Nothing inside the table repeats it, so a
# project cannot disagree with itself about what it is called.
#
# A name containing a `.` has to be quoted -- `[projects."a.b"]`
# -- because TOML reads a bare dot as nesting.
[projects.myproject]

# Optional; `~/vms` if you leave it out.
#
# Root on the VM host under which this project's directories are
# created. Scratch VMs land in
# <remote_root>/scratch/<project>/<name>, so the same scratch
# name in two projects cannot collide.
#
# The value must be anchored: it starts with `/` or `~/`. It
# must also name at least 1 directory below that anchor, with
# no `.` or `..` segment. So `/`, `~`, `~/` and `~/.` are all
# refused, and so is `~vms` -- the `~` has to be a whole
# segment, not a prefix.
#
# bombyx creates, writes into and -- on teardown -- deletes the
# directory it derives from this value, which is why the check
# runs when the config loads rather than at teardown.
#
# A leading `~` is expanded by the remote shell; anywhere else
# it is rejected, as are shell metacharacters.
remote_root = "~/vms"

# Optional. The machine THIS project runs on, when it is not the
# one the `host` line above names. Most entries leave it out.
#
# Written here, it wins for this project alone, and bombyx says
# so on stderr on every command -- because `destroy` runs
# `rm -rf` on whichever machine wins, and both keys sit in this
# one file.
#
# host = "other-vmhost"

# EVERY KEY BELOW A TABLE HEADER BELONGS TO THAT TABLE.
# `remote_root` sits above [projects.myproject.vm] for that
# reason: written after it, the key would parse as
# `projects.myproject.vm.remote_root` and the whole file would
# be refused.

# bombyx builds the machine from this table. `box`, `cpus` and
# `memory` are required: bombyx cannot guess a base image, and
# any size it picked would be wrong on either a laptop or a
# workstation. `provider` is optional and defaults to libvirt.
[projects.myproject.vm]
# The virtualization backend. bombyx passes this to vagrant on
# every project call but `bombyx destroy`, so a host that
# cannot supply it fails rather than quietly building a machine
# of a different kind.
#
# That holds while the machine does not exist yet. Once it does,
# vagrant reads the provider it recorded and ignores this key,
# so changing it means `bombyx destroy` first.
#
# `bombyx destroy` is the one call that does not name it. A
# refused destroy would leave the directory behind, since the
# removal runs only after it.
#
# `hyperv` is accepted and has never been run: it was written
# from Hyper-V's documentation, and bombyx has only ever booted
# libvirt machines.
provider = "libvirt"          # libvirt or hyperv; libvirt if absent

# The base image vagrant starts the machine from.
#
# It has to have `git` installed. The guest clones the project
# itself, so the first thing bombyx's provisioning script does
# inside the VM is look for `git`, and without it the script
# stops there -- after the box download, the machine creation
# and the boot have all already happened.
#
# bombyx cannot tell you sooner than that, because finding out
# what a box contains means starting it.
#
# The name will not tell you which boxes carry it. Two that do
# not are `cloud-image/debian-13` and `debian/bookworm64`; the
# value below does. Booting the box is the only way to be sure.
#
# An ssh URL under `repo` below asks for more. Before cloning,
# the guest fetches the git host's published ssh keys, so it can
# tell the real server from an impostor -- see
# docs/trust-boundary.md. That fetch runs `curl` for GitHub and
# for Bitbucket alike, and reading GitHub's answer needs `jq` on
# top, because GitHub publishes its keys as JSON where Bitbucket
# publishes finished `known_hosts` lines. An `https` URL needs
# neither, because it opens no ssh connection at all.
box = "generic/ubuntu2204"
cpus = 4

# Memory the machine gets. A bare integer is MiB, so `8192` is the
# same 8 GiB it always was. A quoted value may carry a unit
# instead: `"8GB"`, `"512MB"`. The units are powers of two -- `MB`
# and `MiB` both mean one MiB, `GB` and `GiB` both mean 1024 MiB --
# so `"8GB"` is exactly `8192`. Whole numbers only.
memory = "8GB"

# Optional. The name the guest answers to, written into the
# generated Vagrantfile as its hostname. Left out, bombyx derives
# `<project>-agent` from this table's project name, so several
# agent VMs on one host can be told apart rather than all sharing
# the box's default name.
#
# One DNS label: letters, digits and hyphens, no leading or
# trailing hyphen, at most 63 characters. This is the guest's own
# name and is unrelated to the VM host's name, which bombyx passes
# in separately.
#
# The derived name lowercases the project name and turns every
# character that is not a letter or digit into a hyphen, so two
# projects whose names differ only in case or punctuation --
# `web_app` and `web-app` -- derive the same hostname. Set this
# key on one of them to tell the two guests apart.
#
# hostname = "myproject-agent"

# The guest clones this repository once it is running. All
# three keys are required. bombyx sends no project file
# anywhere: the VM fetches the repository itself and runs
# `script` out of its own clone.
#
# A private repository needs a credential inside the guest, and
# code in there can read it. See docs/trust-boundary.md.
[projects.myproject.source]
repo = "https://github.com/you/myproject"
ref = "main"
script = ".bombyx/provision.sh"   # path inside the clone
#
# `script` names a file that must exist in the repository at
# `ref`. The guest refuses to provision without it. The path is
# an example, not a requirement: any path inside the repository
# works, so a project with its own `scripts/` or `tools/` layout
# points `script` there instead. `.bombyx/` is only bombyx's
# suggested home for the files it runs, and the name is spelled
# out here because a leading-dot directory is easy to miss. Part 3
# of bombyx's docs/tutorial.md writes a re-runnable one.

# Optional, and the only key in this table that is a path on
# the VM HOST rather than something the guest hands to git.
#
# Leave it out for a public repository. `git clone` then needs
# no credential, and the generated Vagrantfile carries no
# upload at all.
#
# For a private one, name a private key file on the VM host.
# vagrant reads it there and uploads it into the guest before
# provisioning, so the key never touches your workstation and
# never sits in any repository. Scope it to this one repository:
# code inside the VM can read it, and scoping keeps a stolen
# copy from reaching your other repositories.
#
# Whether it may push is a decision rather than a default. A
# commit made in the guest sits on no branch after the next
# `provision`, so pushing is how work leaves the VM, and it uses
# this key. Read-only is tighter and means the agent cannot push
# at all. See docs/trust-boundary.md.
#
# vagrant runs on the VM host, so `~` is that machine's home
# directory and not yours. bombyx checks the file is there
# before `up`, `provision` or `scratch` creates anything, so a
# path the VM host does not have stops the run with a message
# naming it rather than booting a VM whose clone then fails. A
# key that is there but that the VM host's login user cannot
# read is refused the same way.
#
# The value must be anchored -- it starts with `/` or `~/` --
# and name a file below that anchor. No `.` or `..` segment, no
# `//`, no trailing slash, and `~` only as the first character.
# Every character has to be a letter, a digit, `.`, `_`, `-`,
# `/` or `~`, so a key path with a space in it is refused.
#
# deploy_key = "~/.secrets/myproject-deploy-key"

# Optional, and the only key in this table that is a path on
# YOUR OWN MACHINE. `deploy_key` above names one on the VM host;
# this one names one here.
#
# It is for the project's `.env` -- the API keys and passwords
# the project's own provisioning script needs. That file is
# untracked, so the guest's clone never has one, and this is how
# it gets in.
#
# bombyx reads the file, sends it to the VM host down the
# connection it already has, and has vagrant put it inside the
# guest. The contents never appear in a command line, on either
# machine, and never appear in the generated Vagrantfile.
#
# The VM host holds the file for the length of the vagrant run
# and no longer: the same step that runs vagrant removes it,
# whether the boot worked or not. A run you interrupt is the one
# exception -- the removal never happens, and the file stays
# there until something else runs against that same directory.
# That means the same command: a project's directory and a
# scratch VM's are different places, so `up`, `provision` and
# `destroy` clear one while `scratch` and `discard` clear the
# other and need the same scratch name again.
#
# Inside the guest it lands at `~/.bombyx-env`, in the home of
# the account the agent works as, and bombyx's own provisioning
# script sets it to mode 0600 there before your script runs.
# bombyx puts it nowhere else. Your provisioning script is what
# copies it into place, and the path arrives in
# `BOMBYX_ENV_FILE`:
#
#   cp "$BOMBYX_ENV_FILE" .env
#
# That variable is always set. It holds the path when this key
# is present and an empty string when it is not, so a script
# running under `set -u` can test it either way.
#
# Use this for a secret and the `[projects.myproject.env]` table
# below for anything that is not one. A table of plain settings
# is easier to read than a file, and its values are written into
# the generated Vagrantfile in plain text.
#
# The value must start with `~/` or be an absolute path -- `~`
# is expanded against your own home directory, not the VM
# host's. A relative path is refused, because it would resolve
# against whatever directory you happened to run bombyx from.
# It also has to name a file rather than a directory, so a bare
# `~`, a trailing separator and a final `.` or `..` are refused.
# The separator is the one your own machine writes paths with,
# so a trailing `\` counts on Windows.
# Spaces and quotes in the file name are fine: bombyx opens the
# file itself and hands it to no shell.
#
# bombyx reads the file before it creates anything, so a path
# this machine does not have stops the run with a message naming
# the path it looked for.
#
# What this does not do: the secrets still end up inside the VM,
# and code in the VM can read them. That is unavoidable, since
# the agent needs them to work. See docs/trust-boundary.md.
#
# env_file = "~/.secrets/myproject.env"

# Optional, and a pair: write both or neither. They are how the
# guest clones a private repository over `https` instead of over
# ssh with `deploy_key` above.
#
# `repo_token` names a variable INSIDE the file `env_file`
# points at. Not the token itself -- this file stays free of
# secrets, so it can still be pasted into a bug report. There is
# one copy of the token, in one file, and rotating it means
# editing that file and nothing else.
#
# bombyx reads that one variable, builds a credential from it,
# and sends the credential to the guest before the clone runs.
# It has to be a separate file from the secrets: `git` reads it
# itself, and the format it reads is not the format a `.env`
# file is written in. Your own provisioning script runs long
# after the clone, so it cannot do the converting either.
#
# `repo_user` names the username sent with the token. bombyx
# cannot work this out, because the answer depends on which kind
# of token you made rather than on which host it lives on:
#
#   Bitbucket repository access token   x-token-auth
#   Atlassian API token                 your account's email
#
# Both of those are bitbucket.org, which is why there is no
# table of hosts here and why the config states it outright.
#
# Prefer the narrowest token the host offers. A Bitbucket
# repository access token reaches one repository; an Atlassian
# API token reaches every repository your account can see, and
# Jira and Confluence with them. Tick the scopes the agent
# actually needs -- `repository:write` covers cloning and
# pushing.
#
# WHY A TOKEN RATHER THAN A KEY, on Bitbucket. An ssh access key
# there is read-only and always has been, so a key can clone and
# can never push. An agent that opens pull requests needs to
# push, so it needs the token -- and once it has one, the key
# has nothing left to do. On a host whose keys can push,
# `deploy_key` reaches fewer machines. Neither secret passes
# through a command line -- the token travels on standard input
# the same way this file's contents do. The difference is how
# many machines hold a copy: bombyx never opens the deploy key,
# so it exists on the VM host and in the guest and nowhere else,
# while the token is read here and then exists on your own
# machine, on the VM host for the length of the vagrant run, and
# in the guest.
#
# Four rules bombyx checks while it reads this file, each of
# which stops the run with a message naming the key:
#
#   - Both keys or neither. A variable name with no username
#     leaves bombyx guessing; a username with no variable name
#     has no token to go with.
#   - `env_file` has to be set, since that is the file the
#     variable is read out of.
#   - `repo` has to be an `https` URL. `git` sends the token on
#     every request, so `http` would put it on the wire in plain
#     text, and an ssh URL never asks for one.
#   - `repo` must name no username. `git` asks its credential
#     helper for whichever username the URL carries, and the
#     helper answers only when that matches the one it stored --
#     so a `repo` of `https://me@bitbucket.org/w/r.git` would
#     ship the token into the guest and leave the clone unable
#     to use it. Bitbucket's own clone dialog offers that
#     spelling when you are signed in, so it is worth looking
#     for. Take the `me@` out and let `repo_user` name the
#     username.
#
# A fifth is checked when the file is read, before anything is
# created: if the file holds no variable of that name, or holds
# it empty, the run stops and the message names both the
# variable and the file.
#
# The file bombyx reads is an ordinary `.env`. A line with no
# `=` is ignored, which covers a blank line. A commented-out
# assignment is ignored too, by a different route: the text in
# front of its `=` is `# NAME` rather than the name, so it
# matches nothing.
#
# The name is what comes before the first `=`. An `export` in
# front of it is fine, separated by a space or a tab. Spaces
# around the name and around the value are dropped, and a file
# written on Windows loses its trailing carriage return.
#
# Where the value ENDS depends on whether it is quoted, and this
# is the part worth reading twice:
#
#   TOKEN=abc=d              the value is `abc=d`; a `=` inside
#                            a token needs no escaping
#   TOKEN=abc # rotate soon  the value is `abc`; a `#` with
#                            whitespace in front ends it, which
#                            is the note people write beside a
#                            secret
#   TOKEN=ab#c               the value is `ab#c`; no whitespace
#                            in front, so the `#` is part of it
#   TOKEN= # paste yours     the value is EMPTY, and bombyx
#                            stops the run naming the variable
#                            and this file
#   TOKEN="abc # d"          the value is `abc # d`; quoting is
#                            how you keep one that really does
#                            contain a `#`
#   TOKEN="abc"xyz           the value is `abc`; a quoted value
#                            ends at its closing quote and the
#                            rest of the line is discarded
#
# If a name is assigned twice, the last one wins, which is what
# a shell reading the same file would do.
#
# Inside the guest the credential lands at
# `/home/vagrant/.bombyx-git-credentials` at mode 0600, and
# bombyx points the clone at it so the agent can fetch and push
# there afterwards. Take these keys out of this file and the
# next run removes it from the guest.
#
# What this does not do: the token still ends up inside the VM,
# and code in the VM can read it. See docs/trust-boundary.md.
#
# repo_token = "BITBUCKET_TOKEN"
# repo_user = "x-token-auth"

# Optional. Variables the project's own provisioning script
# reads.
#
# bombyx already hands the guest a set of its own, and the whole
# `BOMBYX_` prefix is reserved for them rather than the names in
# use today -- so the rule to remember is the prefix, not a list
# that grows. bombyx refuses any name carrying it while it reads
# this file. This table is where a project adds its own, and
# both kinds of value belong in it: a constant the project
# always wants, and a value that differs per developer.
# There is no separate place for the second kind because this
# whole file is already the per-developer one.
#
# Every name here becomes a shell variable inside the guest, so
# it has to be spellable as one: a letter or an underscore,
# followed by letters, digits and underscores. `9LIVES` is a
# shell syntax error and `WITH-DASH` is read as a command to
# run, so both are refused while this file is read.
#
# A name starting with `BOMBYX_` is refused as well. The
# generated Vagrantfile writes bombyx's variables and yours
# into one Ruby hash, and a repeated key in a Ruby hash takes
# its last value -- so `BOMBYX_SCRIPT` here would decide which
# script bombyx runs.
#
# These variables reach more than your own script, which is the
# one surprise in this table. Vagrant puts the whole of it in
# the environment of the provisioner, and bombyx's own
# bootstrap script is that provisioner -- so a name that
# changes what that script does changes what bombyx does,
# rather than what your script does. bombyx refuses those names
# while it reads this file, with a message saying so, and this
# is the list:
#
#   PATH  IFS  BASH_ENV  ENV  SHELLOPTS  BASHOPTS
#   LD_PRELOAD  LD_LIBRARY_PATH
#   GIT_SSH_COMMAND  GIT_CONFIG_COUNT  GIT_CONFIG_GLOBAL
#   GIT_CONFIG_SYSTEM  GIT_DIR  GIT_WORK_TREE
#
# Set any of those inside your own script, where they do what
# you meant. Two of them are the ones worth knowing about:
# `SHELLOPTS` can make a provision report success having done
# nothing at all, and `GIT_CONFIG_COUNT` outranks the git
# config bombyx writes on your checkout.
#
# `HOME` is accepted and is the one to think about before
# writing. bombyx clones into `$HOME/<project>`, the directory
# named after this table's project, so setting `HOME` here moves
# the clone, and your script's working directory with it. That is
# measured rather than assumed: a provision with `HOME` pointing
# at a second directory cloned into that directory instead. The
# value has to be absolute, exist, be writable and searchable,
# and be owned by the guest's own account, or bombyx refuses the
# provision and says which of those failed.
#
# Values carry the same rule as `box`, `repo`, `ref`, `script`
# and `deploy_key`: no quote, no backslash, no control
# character, no `#{`, and no leading or trailing space. An
# empty value is refused too. Leave the key out to make a
# variable absent; there is no way to set one to the empty
# string.
#
# The names are rendered in sorted order, byte by byte, so
# re-running bombyx against an unchanged config writes a
# byte-identical Vagrantfile. Byte order is not quite
# alphabetical: every name in capitals comes before every name
# in lower case, and a name starting with an underscore comes
# after both.
#
# These variables exist for the provisioning run and for
# nothing else. Vagrant sets them for the script it starts, so
# they are gone by the time you open a shell in the guest. A
# value a later interactive session needs is one the project's
# own script has to write into a profile.
#
# [projects.myproject.env]
# NODE_MAJOR = "22"
# GIT_USER_NAME = "Your Name"
# GIT_USER_EMAIL = "you@example.com"
