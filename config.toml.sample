# Sample bombyx configuration.
#
# Copy this to your own config file, OUTSIDE ANY REPOSITORY:
#
#   Linux/macOS  ~/.config/bombyx/config.toml
#   Windows      %APPDATA%\bombyx\config.toml
#
# This is the only file bombyx reads. It holds every project you
# drive VMs for, one `[projects.<name>]` table each, and it is
# yours: nothing in it is committed anywhere. Name the project
# you mean on the command line -- `bombyx --project myproject
# up` -- because bombyx reads nothing at all from the project's
# own directory and so cannot work it out from where you stand.
#
# Paths in the comments below, such as docs/trust-boundary.md,
# are in bombyx's own repository:
# https://github.com/breki/bombyx
#
# `--config <path>` reads a different file instead, which is
# useful for keeping two setups apart.

# The machine every project runs on, unless its own table says
# otherwise.
#
# Usually an SSH alias, resolved through your ~/.ssh/config, so
# bombyx never handles addresses, usernames or keys.
#
# One case does not go through ssh at all. If this value names
# the machine you are running bombyx on, bombyx runs vagrant
# here and never calls ssh -- see "Running bombyx against your
# own machine" in bombyx's docs/tutorial.md. That comparison
# looks only at the name, not at your ~/.ssh/config, so an
# alias that happens to equal your own machine's name will be
# taken for this machine even when it points elsewhere. Write
# it as `user@name` to force the ssh route.
#
# Which machine runs the VMs is a property of you rather than of
# any project: everyone on a team has their own hardware on
# their own network. That is why this line lives here and not in
# a repository.
host = "my-vmhost"

# One table per project. The table key is the project name, and
# it doubles as the VM's directory name on the host, e.g.
# ~/vms/myproject. Nothing inside the table repeats it, so a
# project cannot disagree with itself about what it is called.
#
# A name containing a `.` has to be quoted -- `[projects."a.b"]`
# -- because TOML reads a bare dot as nesting.
[projects.myproject]

# Optional; `~/vms` if you leave it out.
#
# Root on the VM host under which this project's directories are
# created. Scratch VMs land in
# <remote_root>/scratch/<project>/<name>, so the same scratch
# name in two projects cannot collide.
#
# The value must be anchored: it starts with `/` or `~/`. It
# must also name at least 1 directory below that anchor, with
# no `.` or `..` segment. So `/`, `~`, `~/` and `~/.` are all
# refused, and so is `~vms` -- the `~` has to be a whole
# segment, not a prefix.
#
# bombyx creates, writes into and -- on teardown -- deletes the
# directory it derives from this value, which is why the check
# runs when the config loads rather than at teardown.
#
# A leading `~` is expanded by the remote shell; anywhere else
# it is rejected, as are shell metacharacters.
remote_root = "~/vms"

# Optional. The machine THIS project runs on, when it is not the
# one the `host` line above names. Most entries leave it out.
#
# Written here, it wins for this project alone, and bombyx says
# so on stderr on every command -- because `destroy` runs
# `rm -rf` on whichever machine wins, and both keys sit in this
# one file.
#
# host = "other-vmhost"

# EVERY KEY BELOW A TABLE HEADER BELONGS TO THAT TABLE.
# `remote_root` sits above [projects.myproject.vm] for that
# reason: written after it, the key would parse as
# `projects.myproject.vm.remote_root` and the whole file would
# be refused.

# bombyx builds the machine from this table. `box`, `cpus` and
# `memory` are required: bombyx cannot guess a base image, and
# any size it picked would be wrong on either a laptop or a
# workstation. `provider` is optional and defaults to libvirt.
[projects.myproject.vm]
# The virtualization backend. bombyx passes this to vagrant on
# every project call but `bombyx destroy`, so a host that
# cannot supply it fails rather than quietly building a machine
# of a different kind.
#
# That holds while the machine does not exist yet. Once it does,
# vagrant reads the provider it recorded and ignores this key,
# so changing it means `bombyx destroy` first.
#
# `bombyx destroy` is the one call that does not name it. A
# refused destroy would leave the directory behind, since the
# removal runs only after it.
#
# `hyperv` is accepted and has never been run: it was written
# from Hyper-V's documentation, and bombyx has only ever booted
# libvirt machines.
provider = "libvirt"          # libvirt or hyperv; libvirt if absent

# The base image vagrant starts the machine from.
#
# It has to have `git` installed. The guest clones the project
# itself, so the first thing bombyx's provisioning script does
# inside the VM is look for `git`, and without it the script
# stops there -- after the box download, the machine creation
# and the boot have all already happened.
#
# bombyx cannot tell you sooner than that, because finding out
# what a box contains means starting it.
#
# The name will not tell you which boxes carry it. Two that do
# not are `cloud-image/debian-13` and `debian/bookworm64`; the
# value below does. Booting the box is the only way to be sure.
#
# An ssh URL under `repo` below asks for more. Before cloning,
# the guest fetches the git host's published ssh keys, so it can
# tell the real server from an impostor -- see
# docs/trust-boundary.md. That fetch runs `curl` for GitHub and
# for Bitbucket alike, and reading GitHub's answer needs `jq` on
# top, because GitHub publishes its keys as JSON where Bitbucket
# publishes finished `known_hosts` lines. An `https` URL needs
# neither, because it opens no ssh connection at all.
box = "generic/ubuntu2204"
cpus = 4
memory = 8192                 # MiB

# The guest clones this repository once it is running. All
# three keys are required. bombyx sends no project file
# anywhere: the VM fetches the repository itself and runs
# `script` out of its own clone.
#
# A private repository needs a credential inside the guest, and
# code in there can read it. See docs/trust-boundary.md.
[projects.myproject.source]
repo = "https://github.com/you/myproject"
ref = "main"
script = "vagrant/provision.sh"   # path inside the clone
#
# `script` names a file that must exist in the repository at
# `ref`. The guest refuses to provision without it. Part 3 of
# bombyx's docs/tutorial.md writes a re-runnable one.

# Optional, and the only key in this table that is a path on
# the VM HOST rather than something the guest hands to git.
#
# Leave it out for a public repository. `git clone` then needs
# no credential, and the generated Vagrantfile carries no
# upload at all.
#
# For a private one, name a private key file on the VM host.
# vagrant reads it there and uploads it into the guest before
# provisioning, so the key never touches your workstation and
# never sits in any repository. Make it a read-only deploy key
# for this one repository: code inside the VM can read it, and
# scoping it is what limits what stealing it is worth. See
# docs/trust-boundary.md.
#
# vagrant runs on the VM host, so `~` is that machine's home
# directory and not yours. bombyx checks the file is there
# before `up`, `provision` or `scratch` creates anything, so a
# path the VM host does not have stops the run with a message
# naming it rather than booting a VM whose clone then fails. A
# key that is there but that the VM host's login user cannot
# read is refused the same way.
#
# The value must be anchored -- it starts with `/` or `~/` --
# and name a file below that anchor. No `.` or `..` segment, no
# `//`, no trailing slash, and `~` only as the first character.
# Every character has to be a letter, a digit, `.`, `_`, `-`,
# `/` or `~`, so a key path with a space in it is refused.
#
# deploy_key = "~/.secrets/myproject-deploy-key"

# Optional. Variables the project's own provisioning script
# reads.
#
# bombyx already hands the guest a set of its own, and the
# whole `BOMBYX_` prefix is reserved for them rather than the
# names in use today -- `BOMBYX_ENV_NAMES` in
# crates/bombyx/src/vagrantfile.rs is the list, and it grows.
# This table is where a project adds
# its own, and both kinds of value belong in it: a constant the
# project always wants, and a value that differs per developer.
# There is no separate place for the second kind because this
# whole file is already the per-developer one.
#
# Every name here becomes a shell variable inside the guest, so
# it has to be spellable as one: a letter or an underscore,
# followed by letters, digits and underscores. `9LIVES` is a
# shell syntax error and `WITH-DASH` is read as a command to
# run, so both are refused while this file is read.
#
# A name starting with `BOMBYX_` is refused as well. The
# generated Vagrantfile writes bombyx's variables and yours
# into one Ruby hash, and a repeated key in a Ruby hash takes
# its last value -- so `BOMBYX_SCRIPT` here would decide which
# script bombyx runs.
#
# These variables reach more than your own script, which is the
# one surprise in this table. Vagrant puts the whole of it in
# the environment of the provisioner, and bombyx's own
# bootstrap script is that provisioner -- so a name that
# changes what that script does changes what bombyx does,
# rather than what your script does. bombyx refuses those names
# while it reads this file, with a message saying so, and this
# is the list:
#
#   PATH  IFS  BASH_ENV  ENV  SHELLOPTS  BASHOPTS
#   LD_PRELOAD  LD_LIBRARY_PATH
#   GIT_SSH_COMMAND  GIT_CONFIG_COUNT  GIT_CONFIG_GLOBAL
#   GIT_CONFIG_SYSTEM  GIT_DIR  GIT_WORK_TREE
#
# Set any of those inside your own script, where they do what
# you meant. Two of them are the ones worth knowing about:
# `SHELLOPTS` can make a provision report success having done
# nothing at all, and `GIT_CONFIG_COUNT` outranks the git
# config bombyx writes on your checkout.
#
# `HOME` is accepted and is the one to think about before
# writing. bombyx clones into `$HOME/project`, so setting
# `HOME` here moves the clone, and your script's working
# directory with it. That is measured rather than assumed: a
# provision with `HOME` pointing at a second directory cloned
# into that directory instead. The value has to be absolute,
# exist, be writable and searchable, and be owned by the
# guest's own account, or bombyx refuses the provision and says
# which of those failed.
#
# Values carry the same rule as `box`, `repo`, `ref`, `script`
# and `deploy_key`: no quote, no backslash, no control
# character, no `#{`, and no leading or trailing space. An
# empty value is refused too. Leave the key out to make a
# variable absent; there is no way to set one to the empty
# string.
#
# The names are rendered in sorted order, byte by byte, so
# re-running bombyx against an unchanged config writes a
# byte-identical Vagrantfile. Byte order is not quite
# alphabetical: every name in capitals comes before every name
# in lower case, and a name starting with an underscore comes
# after both.
#
# These variables exist for the provisioning run and for
# nothing else. Vagrant sets them for the script it starts, so
# they are gone by the time you open a shell in the guest. A
# value a later interactive session needs is one the project's
# own script has to write into a profile.
#
# [projects.myproject.env]
# NODE_MAJOR = "22"
# GIT_USER_NAME = "Your Name"
# GIT_USER_EMAIL = "you@example.com"
